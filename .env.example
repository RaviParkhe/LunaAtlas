# .env.example — Lunar Habitat AI & LunaAstra Environment Configuration
#
# Obtain Google Gemini API Key from: https://aistudio.google.com/app/apikey
# If not set or invalid, the system automatically uses deterministic fallback XAI briefings.

GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
GEMINI_MODEL=gemini-2.0-flash

# Blockchain Configuration (Optional local or testnet RPC)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=1337
